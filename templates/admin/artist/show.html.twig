{% extends 'base.html.twig' %}

{% block title %}Artist{% endblock %}

{% block body %}
    <h1>Artist</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ artist.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ artist.name }}</td>
            </tr>
            <tr>
                <th>Country</th>
                <td>{{ artist.country }}</td>
            </tr>
            <tr>
                <th>City</th>
                <td>{{ artist.city }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ artist.description }}</td>
            </tr>
            <tr>
                <th>Picture</th>
                <td>{{ artist.picture }}</td>
            </tr>
            <tr>
                <th>AcceptedAt</th>
                <td>{{ artist.acceptedAt ? artist.acceptedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('admin_artist_index') }}">back to list</a>

    <a href="{{ path('admin_artist_edit', {'id': artist.id}) }}">edit</a>

    {{ include('admin/artist/_delete_form.html.twig') }}
{% endblock %}

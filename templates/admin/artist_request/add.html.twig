{% extends 'base.html.twig' %}

{% block body %}

    <h1>Devenir artiste</h1>

    {{ form_start(form) }}

    {{ form_row(form.name) }}
    {{ form_row(form.country) }}
    {{ form_row(form.city) }}
    {{ form_row(form.description) }}

    <h3>Liens</h3>

    <div
        data-controller="collection"
        data-collection-index-value="{{ form.rawLinks|length }}"
        data-collection-prototype-value="{{ form_widget(form.rawLinks.vars.prototype)|e('html_attr') }}"
    >

        <div data-collection-target="container">
            {% for linkForm in form.rawLinks %}
                <div class="link-item">
                    {{ form_row(linkForm.name) }}
                    {{ form_row(linkForm.url) }}
                </div>
            {% endfor %}
        </div>

        <button type="button" data-action="collection#add">
            + Ajouter un lien
        </button>
    </div>

    <button type="submit">Envoyer</button>

    {{ form_end(form) }}

{% endblock %}

<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Her.Frequencies{% endblock %}</title>
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header class="header">
            <a href="{{ path('app_home') }}" class="header__logo">HER.FREQUENCIES</a>

            <nav class="header__nav">
                <a href="{{ path('app_home') }}" class="header__nav-link">Artists</a>
                <a href="#" class="header__nav-link">About us</a>
                <a href="#" class="header__nav-link">Submit</a>
            </nav>

            <div class="header__actions"></div>

            <button class="header__burger" aria-label="Menu">
                <span></span>
                <span></span>
                <span></span>
            </button>
        </header>

        {% block body %}{% endblock %}
    </body>
</html>
